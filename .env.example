# ── Local development (.env.local) ──────────────────────────────
CONVEX_DEPLOYMENT=your-dev-deployment-name
VITE_CONVEX_URL=https://your-dev-deployment.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Server-side Clerk (TanStack Start middleware):
CLERK_SECRET_KEY=sk_test_...

# ── Convex Dashboard → Settings → Environment Variables ─────────
# Required for receipt OCR:
# GEMINI_API_KEY=your-google-ai-key
# Optional model override:
# GEMINI_MODEL=gemini-3.5-flash

# Required for Clerk JWT validation:
# CLERK_JWT_ISSUER_DOMAIN=https://your-instance.clerk.accounts.dev

# Leftover Clerk Billing webhook only (not Host Pro). Host Pro will use Stripe webhooks:
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Optional — dev-only Convex flags (onboarding reset mutation, etc.):
# DEV_MODE=true
# Never set on production (coordinated-warbler-782).

# ── Vercel → Project Settings → Environment Variables ───────────
# Required for production frontend build:
# VITE_CONVEX_URL=https://your-prod-deployment.convex.cloud
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...

# Optional — client error tracking (Sentry):
# VITE_SENTRY_DSN=https://...@sentry.io/...

# Optional — used for QR/link copy when window.origin unavailable at build time:
# VITE_APP_ORIGIN=https://onova-za-smetkata.com

# ── E2E (Playwright) ────────────────────────────────────────────
# CLERK_SECRET_KEY=sk_test_...  (Clerk Testing Tokens)
