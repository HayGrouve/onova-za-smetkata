# Host sign-in runs on the shared Акаунт: the Clerk app "онова за" (ADR 0005).
# Local dev, Vercel Preview/Development and CI e2e use its development
# instance (Frontend API https://fancy-bobcat-6703.clerk.accounts.dev, sign-in
# on its Account Portal) and the dev Convex deployment striped-shepherd-984.
# Production uses its production instance (clerk.onovaza.com, sign-in on
# https://onovaza.com/vhod) and Convex prod coordinated-warbler-782.
# Full matrix: docs/DEPLOY.md → "Environment variables".

# ── Local development (.env.local, never committed) ─────────────
# `clerk env pull --app app_3Lk5Y1X31WAloPBVBUnYrtoTplv --instance dev --print`
# prints both Clerk keys; copy them in here.
CONVEX_DEPLOYMENT=dev:striped-shepherd-984
VITE_CONVEX_URL=https://striped-shepherd-984.convex.cloud
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Server-side Clerk (TanStack Start middleware), same dev instance:
CLERK_SECRET_KEY=sk_test_...

# Leave these unset locally and in Preview/Development:
# VITE_APP_ORIGIN: share links and the canonical URL fall back to the page's
#   own origin (localhost, *.vercel.app).
# VITE_CLERK_SIGN_IN_URL / VITE_CLERK_SIGN_UP_URL: Clerk falls back to the dev
#   Account Portal. A relative /login here would make /login redirect to itself.
# CLERK_AUTHORIZED_PARTIES: SSR then skips the token's azp check.

# ── E2E (Playwright, also in .env.local) ────────────────────────
# A +clerk_test user in the dev instance (e2e/README.md):
# E2E_CLERK_USER_EMAIL=smetkata+clerk_test@example.com

# ── Convex Dashboard → Settings → Environment Variables ─────────
# Required for Clerk JWT validation (dev: the dev Frontend API URL above):
# CLERK_JWT_ISSUER_DOMAIN=https://fancy-bobcat-6703.clerk.accounts.dev
# Signing secret of the instance's user.deleted endpoint (/clerk/webhook):
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...

# Required for receipt OCR:
# GEMINI_API_KEY=your-google-ai-key
# Optional model override:
# GEMINI_MODEL=gemini-3.5-flash

# Host Pro billing (Stripe Managed Payments): off unless BILLING_ENABLED=true.
# See docs/DEPLOY.md → "Host Pro billing". While off, every Host is free/unlimited.
# BILLING_ENABLED=true
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# APP_ORIGIN=http://localhost:3000

# Optional dev-only Convex flags (onboarding reset mutation, etc.):
# DEV_MODE=true
# Never set on production (coordinated-warbler-782).

# ── Vercel → Project Settings → Environment Variables ───────────
# Production ("онова за" production instance, Convex prod):
#   VITE_CONVEX_URL=https://coordinated-warbler-782.convex.cloud
#   VITE_CLERK_PUBLISHABLE_KEY=pk_live_...
#   CLERK_SECRET_KEY=sk_live_...   (the key named smetkata, Sensitive)
#   VITE_CLERK_SIGN_IN_URL=https://onovaza.com/vhod
#   VITE_CLERK_SIGN_UP_URL=https://onovaza.com/vhod
#   CLERK_AUTHORIZED_PARTIES=https://smetkata.onovaza.com
#   VITE_APP_ORIGIN=https://smetkata.onovaza.com
# Preview and Development (dev instance, dev Convex):
#   VITE_CONVEX_URL=https://striped-shepherd-984.convex.cloud
#   VITE_CLERK_PUBLISHABLE_KEY=pk_test_...  CLERK_SECRET_KEY=sk_test_...
#   no VITE_APP_ORIGIN, no sign-in URLs, no CLERK_AUTHORIZED_PARTIES
